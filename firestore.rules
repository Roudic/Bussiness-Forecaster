rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function onTeam(st) { return st.ownerUid == request.auth.uid || me() in st.managers || me() in st.viewers; }
    function store(sid) { return get(/databases/$(database)/documents/stores/$(sid)).data; }
    function isOwner(sid) { return signedIn() && store(sid).ownerUid == request.auth.uid; }
    function canEdit(sid) { return isOwner(sid) || (signedIn() && me() in store(sid).managers); }
    function canView(sid) { return signedIn() && onTeam(store(sid)); }

    // each person's own space (from before store teams)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // a store: only its team can see it, only the owner can change the team
    match /stores/{sid} {
      allow read: if signedIn() && onTeam(resource.data);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.managers is list && request.resource.data.viewers is list;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.managers is list && request.resource.data.viewers is list;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      // sales, settings, positions: the team sees them; owner and managers change them; only the owner deletes.
      // {sub} makes this cover only what's inside the store, never the store record (the team list) itself
      match /{sub}/{document=**} {
        allow read: if canView(sid);
        allow create, update: if canEdit(sid);
        allow delete: if isOwner(sid);
      }
    }
  }
}
